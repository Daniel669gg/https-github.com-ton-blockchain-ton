# Ghost Security Platform v3.0 — Environment Variables

# ── LLM Providers ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=           # Claude (claude.ai API)
OPENAI_API_KEY=              # OpenAI / any OpenAI-compatible endpoint
GEMINI_API_KEY=              # Google Gemini
OPENAI_BASE_URL=https://api.openai.com/v1  # override for local LLMs

# ── Ollama (local LLM) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector Memory ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=              # only for Qdrant Cloud

# ── GitHub App ─────────────────────────────────────────────────────
GITHUB_TOKEN=                # for PR creation
GITHUB_APP_ID=               # for GitHub App webhook
GITHUB_PRIVATE_KEY=          # PEM key (newlines as \n)
GITHUB_WEBHOOK_SECRET=       # webhook HMAC secret

# ── Deployment ─────────────────────────────────────────────────────
API_PORT=8000
WORKERS=2
LOG_LEVEL=INFO
ENV=production
SCAN_TARGET=/tmp             # directory mounted into container for scanning

# ── Telemetry ──────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. http://jaeger:4317
GRAFANA_PASSWORD=ghost_admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
