{
  "compilerOptions": {
    "module":      "commonjs",
    "target":      "ES2022",
    "outDir":      "./out",
    "rootDir":     "./src",
    "strict":      true,
    "lib":         ["ES2022"],
    "sourceMap":   true,
    "esModuleInterop": true,
    "skipLibCheck":    true
  },
  "exclude": ["node_modules", ".vscode-test"]
}
